{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cat Key",
  "mainBinaryName": "CatKey",
  "version": "1.0.3",
  "identifier": "com.masterfully.catkey",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Masterfully",
    "copyright": "© 2026 Masterfully",
    "category": "Utility",
    "shortDescription": "Purr-fect keyboard shortcuts for Windows",
    "longDescription": "Cat Key remaps keyboard shortcuts on Windows (Alt+C to Ctrl+C and friends), per app if you like, with an animated cat that keeps you company.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
