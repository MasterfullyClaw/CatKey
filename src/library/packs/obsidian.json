        },
        {
          "name": "Command palette",
          "keys": "Mod+P",
          "fav": true
        },
        {
          "name": "Search all notes",
          "keys": "Mod+Shift+F",
          "fav": true
        },
        {
          "name": "Graph view",
          "keys": "Mod+G",
          "fav": true
        },
        {
          "name": "New note",
          "keys": "Mod+N",
          "fav": true
        },
        {
          "name": "New tab",
          "keys": "Mod+T"
        },
        {
          "name": "Close tab",
          "keys": "Mod+W"
        },
        {
          "name": "Back",
          "keys": "Mod+Opt+Left",
          "fav": true
        },
        {
          "name": "Forward",
          "keys": "Mod+Opt+Right"
