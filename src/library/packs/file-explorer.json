          "fav": true
        },
        {
          "name": "Rename",
          "keys": "F2",
          "fav": true
        },
        {
          "name": "Up one folder",
          "keys": "Alt+Up",
          "fav": true
        },
        {
          "name": "Back",
          "keys": "Alt+Left"
        },
        {
          "name": "Forward",
          "keys": "Alt+Right"
        },
        {
